# Root pointers for docker compose (optional overrides).
# Copy to .env if you want to change defaults. Local dev uses:
#   backend/.env.example  → backend/.env
#   frontend/.env.example → frontend/.env.local

FRONTEND_PORT=3002
BACKEND_PORT=8002

# Baked into the frontend image at build time; browser → host-mapped API.
VITE_API_BASE=http://localhost:8002

# Backend (compose forces OLLAMA_BASE_URL=http://host.docker.internal:11434)
OLLAMA_CHAT_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=nomic-embed-text
SIMILARITY_CUTOFF=0.45
CORS_ORIGINS=http://localhost:3002,http://127.0.0.1:3002
